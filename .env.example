# ============================================================
# MudiPro (Mudir Dokan Pro) — Environment Variables Template
# Copy to .env and replace placeholders with real values.
# NEVER commit .env or put secret keys in VITE_* variables!
# ============================================================

# --- Frontend (Public — safe for browser bundle) ---
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Optional: Set when hosting React frontend on Firebase Hosting (https://mudipro.web.app)
# and Express backend on Render (e.g. https://mudipro-api.onrender.com). Leave empty for same-origin.
VITE_API_BASE_URL=""

# --- Backend (Server-Only — NEVER expose to frontend) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"
SUPABASE_STORAGE_BUCKET="mudipro-media"

# Supabase PostgreSQL (Use Supavisor IPv4 Session/Transaction Pooler URI)
# Example: postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Comma-separated allowed frontend origins for CORS
CORS_ORIGIN="https://mudipro.web.app,https://vaulted-path-r91ww.web.app"

# HMAC signing secret for Customer Self-Service Portal sessions
PORTAL_SESSION_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET"

# Public URL where the app is hosted
APP_URL="https://mudipro.web.app"
